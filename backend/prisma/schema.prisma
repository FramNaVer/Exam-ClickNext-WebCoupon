generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id          Int           @id @default(autoincrement())
  username    String        @unique
  password    String
  points      Int           @default(0)
  created_at  DateTime      @default(now())
  updated_at  DateTime      @updatedAt
  redemptions Redemption[]

  @@map("user")
}

model Reward {
  id                Int          @id @default(autoincrement())
  title             String       @unique
  description       String
  points_required   Int
  image_url         String
  expiry_date       DateTime
  redeem_start_date DateTime
  redeem_end_date   DateTime
  terms_condition   String
  stock             Int          @default(0)
  created_at        DateTime     @default(now())
  updated_at        DateTime     @updatedAt
  redemptions       Redemption[]

  @@map("rewards")
}

model Redemption {
  id              Int      @id @default(autoincrement())
  users_id        Int
  reward_id       Int
  redeemed_points Int
  redeemed_at     DateTime @default(now())
  status          String   @default("redeemed")
  user            User     @relation(fields: [users_id], references: [id])
  reward          Reward   @relation(fields: [reward_id], references: [id])

  @@unique([users_id, reward_id])
  @@map("redemptions")
}

